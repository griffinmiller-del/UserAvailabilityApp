@using ToggleAvailabilityBlazor.Models

<div class="summary-statistics">

    <div class="summary-stat-card">

        <div class="summary-stat-label">
            Total Time
        </div>

        <div class="summary-stat-value">
            @TotalTime
        </div>

        <div class="summary-stat-subtitle">
            Selected period
        </div>

    </div>


    <div class="summary-stat-card">

        <div class="summary-stat-label">
            Average
        </div>

        <div class="summary-stat-value">
            @AverageTime
        </div>

        <div class="summary-stat-subtitle">
            Per weekday
        </div>

    </div>


    <div class="summary-stat-card">

        <div class="summary-stat-label">
            Days in Office
        </div>

        <div class="summary-stat-value">
            @DaysInOffice
        </div>

        <div class="summary-stat-subtitle">
            Days with recorded time
        </div>

    </div>


    <div class="summary-stat-card">

        <div class="summary-stat-label">
            Highest Day
        </div>

        <div class="summary-stat-value">
            @HighestDay
        </div>

        <div class="summary-stat-subtitle">
            Most time in office
        </div>

    </div>

</div>


@code {

    [Parameter]
    public string TotalTime { get; set; } = "0h 0m";


    [Parameter]
    public string AverageTime { get; set; } = "0h 0m";


    [Parameter]
    public int DaysInOffice { get; set; }


    [Parameter]
    public string HighestDay { get; set; } = "0h 0m";
}