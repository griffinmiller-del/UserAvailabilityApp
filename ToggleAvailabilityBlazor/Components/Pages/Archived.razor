@page "/archived"

@using ToggleAvailabilityBlazor.Models
@using ToggleAvailabilityBlazor.Services

@inject AvailabilityService AvailabilityService

<PageTitle>Archived Users</PageTitle>


<div class="archived-page">

    <div class="archived-header">

        <div class="archived-header-content">

            <NavLink href="/history"
                     class="archived-link">

                History

            </NavLink>


            <div class="archived-title">

                <h1>
                    Archived Users
                </h1>

                <p>
                    Select a person to view their archived office time.
                </p>

            </div>


            <NavLink href="/archived"
                     class="archived-link active">

                Archived

            </NavLink>

        </div>

    </div>


    <div class="people-list">

        @if (AvailabilityService.InactiveUsers.Count == 0)
        {
            <div class="empty-message">

                No archived users.

            </div>
        }
        else
        {
            @foreach (var user in AvailabilityService.InactiveUsers)
            {
                <NavLink href="@($"/history/{user.UserId}")"
                         class="person-row">

                    <span class="person-name">
                        @user.Name
                    </span>

                    <span class="person-arrow">
                        ›
                    </span>

                </NavLink>
            }
        }

    </div>

</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        await AvailabilityService
            .ConnectAsync();

        await AvailabilityService
            .GetInactiveUsersAsync();
    }

}


<style>

    .archived-page {
        min-height: 100vh;
        padding: 32px;
        box-sizing: border-box;
        background: #111111;
        color: #ffffff;
        font-family: "Segoe UI", Arial, sans-serif;
    }


    .archived-header {
        width: 100%;
        max-width: 900px;
        margin: 0 auto 28px auto;
    }


    .archived-header-content {
        display: grid;
        grid-template-columns: 120px 1fr 120px;
        align-items: center;
        width: 100%;
    }


    .archived-title {
        text-align: center;
    }


        .archived-title h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 500;
        }


        .archived-title p {
            margin: 7px 0 0 0;
            color: #777777;
            font-size: 14px;
        }


    .archived-link {
        color: #777777;
        text-decoration: none;
        font-size: 15px;
        transition: color 0.15s ease;
    }


        .archived-link:first-child {
            text-align: left;
        }


        .archived-link:last-child {
            text-align: right;
        }


        .archived-link:hover {
            color: #f2c94c;
        }


        .archived-link.active {
            color: #f2c94c;
        }


    .people-list {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }


    .person-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 58px;
        padding: 0 18px;
        box-sizing: border-box;
        background: #1c1c1c;
        border: 1px solid #303030;
        border-bottom: none;
        color: #ffffff;
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }


        .person-row:first-child {
            border-radius: 9px 9px 0 0;
        }


        .person-row:last-child {
            border-bottom: 1px solid #303030;
            border-radius: 0 0 9px 9px;
        }


        .person-row:only-child {
            border-radius: 9px;
            border-bottom: 1px solid #303030;
        }


        .person-row:hover {
            background: #232323;
            border-color: #454545;
        }


    .person-name {
        font-size: 16px;
        font-weight: 400;
    }


    .person-arrow {
        font-size: 25px;
        line-height: 1;
        color: #666666;
    }


    .person-row:hover .person-arrow {
        color: #f2c94c;
    }


    .empty-message {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        box-sizing: border-box;
        background: #1c1c1c;
        border: 1px solid #303030;
        border-radius: 9px;
        color: #777777;
        font-size: 14px;
    }


    @@media (max-width: 600px) {

        .archived-page {
            padding: 20px;
        }


        .archived-header-content {
            grid-template-columns: 80px 1fr 80px;
        }


        .archived-title h1 {
            font-size: 23px;
        }


        .archived-title p {
            display: none;
        }
    }

</style>
