    // ==================================================
    // Clone User
    // ==================================================

    private static User CloneUser(
        User user)
    {
        return new User
        {
            UserId =
                user.UserId,

            Name =
                user.Name,

            IsAvailable =
                user.IsAvailable,

            Status =
                user.Status,

            InOfficeStartTime =
                user.InOfficeStartTime,

            TotalTimeInOffice =
                user.TotalTimeInOffice
        };
    }


    // ==================================================
    // Dispose
    // ==================================================

    public void Dispose()
    {
        Console.WriteLine(
            "[Blazor Page] Disposing component.");


        AvailabilityService.UserUpdated -=
            OnUserUpdated;


        AvailabilityService.UsersChanged -=
            OnUsersChanged;


        _timerCts.Cancel();

        _timerCts.Dispose();

        _timer?.Dispose();
    }

    private async Task OpenUserDetails(User user)
    {
        _selectedUser = CloneUser(user);

        _selectedRange = GraphRange.Week;

        _customStartDate =
            DateOnly.FromDateTime(
                DateTime.Now.AddDays(-6));

        _customEndDate =
            DateOnly.FromDateTime(
                DateTime.Now);

        _graphAnimating = false;

        _userHistory =
            await AvailabilityService.GetUserHistory(
                user.UserId);

        UpdateGraphData();

        await InvokeAsync(StateHasChanged);
    }

    private void UpdateGraphData()
    {
        _graphData =
            GetGraphPoints();
    }

    private async Task SetRange(GraphRange range)
    {
        if (_selectedUser is null)
        {
            return;
        }

        if (_selectedRange == range)
        {
            return;
        }

        // Start animation
        _graphAnimating = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(180);

        // Change range
        _selectedRange = range;

        // Reset custom dates when Custom is selected
        if (range == GraphRange.Custom)
        {
            _customStartDate =
                DateOnly.FromDateTime(
                    DateTime.Now.AddDays(-6));

            _customEndDate =
                DateOnly.FromDateTime(
                    DateTime.Now);
        }

        // IMPORTANT:
        // Rebuild the graph using the newly selected range.
        UpdateGraphData();

        // Finish animation
        _graphAnimating = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task CustomDateChanged()
    {
        if (_customEndDate < _customStartDate)
        {
            return;
        }

        _graphAnimating = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(180);

        UpdateGraphData();

        _graphAnimating = false;

        await InvokeAsync(StateHasChanged);
    }


    private async Task FinishCustomDateAnimation()
    {
        await Task.Delay(180);

        _graphAnimating = false;

        await InvokeAsync(
            StateHasChanged);
    }

    private List<GraphPoint> GetGraphPoints()
    {
        DateOnly today =
            DateOnly.FromDateTime(
                DateTime.Now);

        DateOnly startDate;
        DateOnly endDate =
            today;

        switch (_selectedRange)
        {
            case GraphRange.Week:

                startDate =
                    today.AddDays(-6);

                break;


            case GraphRange.Month:

                startDate =
                    today.AddDays(-29);

                break;


            case GraphRange.Year:

                startDate =
                    today.AddDays(-364);

                break;


            case GraphRange.Custom:

                startDate =
                    _customStartDate;

                endDate =
                    _customEndDate;

                break;


            default:

                startDate =
                    today.AddDays(-6);

                break;
        }


        var history =
            _userHistory
                .GroupBy(x => x.Date)
                .ToDictionary(
                    x => x.Key,
                    x => x.Sum(y => y.TimeInOffice.TotalHours));


        var points =
            new List<GraphPoint>();


        for (
            DateOnly date = startDate;
            date <= endDate;
            date = date.AddDays(1))
        {
            history.TryGetValue(
                date,
                out double hours);


            points.Add(
                new GraphPoint
                {
                    Date = date,
                    Hours = hours
                });
        }


        return points;
    }


    private RenderFragment BuildGraph()
    {
        return builder =>
        {
            var points =
                _graphData;

            if (points.Count == 0)
            {
                return;
            }


            const double width = 1500;
            const double height = 500;

            const double left = 65;
            const double right = 25;
            const double top = 25;
            const double bottom = 55;

            double graphWidth =
                width - left - right;

            double graphHeight =
                height - top - bottom;


            double maxHours =
                Math.Max(
                    8,
                    Math.Ceiling(
                        points.Max(x => x.Hours)));


            double xStep =
                points.Count == 1
                    ? 0
                    : graphWidth /
                      (points.Count - 1);


            string BuildPath()
            {
                var path = "";

                for (int i = 0; i < points.Count; i++)
                {
                    double x =
                        left +
                        (i * xStep);

                    double y =
                        top +
                        graphHeight -
                        (
                            points[i].Hours /
                            maxHours *
                            graphHeight
                        );


                    path +=
                        i == 0
                            ? $"M {x:F2} {y:F2}"
                            : $" L {x:F2} {y:F2}";
                }

                return path;
            }


            builder.OpenElement(
                0,
                "svg");

            builder.AddAttribute(
                1,
                "class",
                "office-history-graph");

            builder.AddAttribute(
                2,
                "viewBox",
                $"0 0 {width} {height}");

            builder.AddAttribute(
                3,
                "preserveAspectRatio",
                "xMidYMid meet");


            // ----------------------------------------------
            // Horizontal grid lines
            // ----------------------------------------------

            int gridLines = 4;

            for (int i = 0; i <= gridLines; i++)
            {
                double hours =
                    maxHours *
                    i /
                    gridLines;

                double y =
                    top +
                    graphHeight -
                    (
                        i *
                        graphHeight /
                        gridLines
                    );


                builder.OpenElement(
                    10 + i,
                    "line");

                builder.AddAttribute(
                    11 + i,
                    "x1",
                    left);

                builder.AddAttribute(
                    12 + i,
                    "x2",
                    width - right);

                builder.AddAttribute(
                    13 + i,
                    "y1",
                    y);

                builder.AddAttribute(
                    14 + i,
                    "y2",
                    y);

                builder.AddAttribute(
                    15 + i,
                    "class",
                    "graph-grid-line");

                builder.CloseElement();


                // Y-axis label

                builder.OpenElement(
                    30 + i,
                    "text");

                builder.AddAttribute(
                    31 + i,
                    "x",
                    left - 10);

                builder.AddAttribute(
                    32 + i,
                    "y",
                    y + 4);

                builder.AddAttribute(
                    33 + i,
                    "text-anchor",
                    "end");

                builder.AddAttribute(
                    34 + i,
                    "class",
                    "graph-axis-label");

                builder.AddContent(
                    35 + i,
                    $"{hours:0}h");

                builder.CloseElement();
            }


            // ----------------------------------------------
            // Line
            // ----------------------------------------------

            builder.OpenElement(
                100,
                "path");

            builder.AddAttribute(
                101,
                "d",
                BuildPath());

            builder.AddAttribute(
                102,
                "class",
                "graph-line");

            builder.CloseElement();


            // ----------------------------------------------
            // Points
            // ----------------------------------------------

            for (int i = 0; i < points.Count; i++)
            {
                double x =
                    left +
                    (i * xStep);

                double y =
                    top +
                    graphHeight -
                    (
                        points[i].Hours /
                        maxHours *
                        graphHeight
                    );


                builder.OpenElement(
                    200 + i,
                    "circle");

                builder.AddAttribute(
                    201 + i,
                    "cx",
                    x);

                builder.AddAttribute(
                    202 + i,
                    "cy",
                    y);

                builder.AddAttribute(
                    203 + i,
                    "r",
                    5);

                builder.AddAttribute(
                    204 + i,
                    "class",
                    "graph-point");


                // ==========================================
                // Tooltip
                // ==========================================

                builder.OpenElement(
                    205 + i,
                    "title");

                builder.AddContent(
                    206 + i,
                    $"{points[i].Date:MMMM d, yyyy} — {FormatGraphTime(points[i].Hours)}");

                builder.CloseElement();


                builder.CloseElement();


                // ------------------------------------------
                // Date labels
                // ------------------------------------------

                bool showLabel =
                    points.Count <= 14 ||
                    i == 0 ||
                    i == points.Count - 1 ||
                    i % Math.Max(
                        1,
                        points.Count / 8) == 0;


                if (showLabel)
                {
                    builder.OpenElement(
                        300 + i,
                        "text");

                    builder.AddAttribute(
                        301 + i,
                        "x",
                        x);

                    builder.AddAttribute(
                        302 + i,
                        "y",
                        height - 20);

                    builder.AddAttribute(
                        303 + i,
                        "text-anchor",
                        "middle");

                    builder.AddAttribute(
                        304 + i,
                        "class",
                        "graph-date-label");

                    builder.AddContent(
                        305 + i,
                        FormatGraphDate(
                            points[i].Date));

                    builder.CloseElement();
                }
            }


            builder.CloseElement();
        };
    }

    private static string FormatGraphTime(double hours)
{
    TimeSpan time =
        TimeSpan.FromHours(hours);

    return
        $"{(int)time.TotalHours:00}:" +
        $"{time.Minutes:00}:" +
        $"{time.Seconds:00}";
}


    private string FormatGraphDate(
    DateOnly date)
    {
        return _selectedRange switch
        {
            GraphRange.Year =>
                date.ToString("MMM"),

            _ =>
                date.ToString("MMM d")
        };
    }

    private string GetGraphDateDescription()
    {
        DateOnly today =
            DateOnly.FromDateTime(
                DateTime.Now);

        return _selectedRange switch
        {
            GraphRange.Week =>
                $"{today.AddDays(-6):MMM d} – {today:MMM d, yyyy}",

            GraphRange.Month =>
                $"{today.AddDays(-29):MMM d} – {today:MMM d, yyyy}",

            GraphRange.Year =>
                $"{today.AddDays(-364):MMM d, yyyy} – {today:MMM d, yyyy}",

            GraphRange.Custom =>
                $"{_customStartDate:MMM d, yyyy} – {_customEndDate:MMM d, yyyy}",

            _ =>
                ""
        };
    }

    private static bool IsUserAvailable(
    User user)
    {
        return
            user.IsAvailable ||
            user.Status == Status.InOffice;
    }

    private void CloseUserDetails()
    {
        _selectedUser = null;

        _userHistory = [];

        StateHasChanged();
    }

    private SummaryStatistics GetSummaryStatistics()
    {
        if (_selectedUser is null)
        {
            return new SummaryStatistics();
        }

        var points =
            GetGraphPoints();

        if (points.Count == 0)
        {
            return new SummaryStatistics();
        }


        // ----------------------------------------------
        // Total time
        // ----------------------------------------------

        double totalHours =
            points.Sum(x => x.Hours);


        TimeSpan totalTime =
            TimeSpan.FromHours(totalHours);


        // ----------------------------------------------
        // Average per calendar day
        // ----------------------------------------------

        TimeSpan averageTime =
            points.Count > 0
                ? TimeSpan.FromHours(
                    totalHours / points.Count)
                : TimeSpan.Zero;


        // ----------------------------------------------
        // Days with office time
        // ----------------------------------------------

        int daysInOffice =
            points.Count(x => x.Hours > 0);


        // ----------------------------------------------
        // Longest day
        // ----------------------------------------------

        double longestHours =
            points.Count > 0
                ? points.Max(x => x.Hours)
                : 0;


        TimeSpan longestDay =
            TimeSpan.FromHours(longestHours);


        return new SummaryStatistics
        {
            TotalTime = totalTime,
            AverageTime = averageTime,
            DaysInOffice = daysInOffice,
            LongestDay = longestDay
        };
    }

    private static string FormatDuration(
    TimeSpan duration)
    {
        if (duration < TimeSpan.Zero)
        {
            duration = TimeSpan.Zero;
        }


        int hours =
            (int)duration.TotalHours;

        int minutes =
            duration.Minutes;


        if (hours == 0)
        {
            return $"{minutes}m";
        }


        return $"{hours}h {minutes:00}m";
    }

    private string GetSummaryPeriodText()
    {
        return _selectedRange switch
        {
            GraphRange.Week =>
                "Last 7 days",

            GraphRange.Month =>
                "Last 30 days",

            GraphRange.Year =>
                "Last 365 days",

            GraphRange.Custom =>
                "Selected period",

            _ =>
                ""
        };
    }

    private class SummaryStatistics
    {
        public TimeSpan TotalTime { get; set; }

        public TimeSpan AverageTime { get; set; }

        public int DaysInOffice { get; set; }

        public TimeSpan LongestDay { get; set; }
    }
    private class GraphPoint
    {
        public DateOnly Date { get; set; }

        public double Hours { get; set; }
    }

    private enum GraphRange
    {
        Week,
        Month,
        Year,
        Custom
    }
