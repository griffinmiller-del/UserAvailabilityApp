@page "/"

@using ToggleAvailabilityBlazor.Models
@using ToggleAvailabilityBlazor.Services

@implements IDisposable

@rendermode InteractiveServer

@inject AvailabilityService AvailabilityService

<PageTitle>User Availability</PageTitle>


<div class="availability-page">

    <!-- ================================================== -->
    <!-- Header -->
    <!-- ================================================== -->

    <div class="page-header">

        <div>

            <div class="connection-status">

                <span class="connection-indicator @(AvailabilityService.IsConnected
                                        ? "connected"
                                        : "disconnected")">
                </span>

                <span>
                    @(AvailabilityService.IsConnected
                        ? "Connected"
                        : "Disconnected")
                </span>

            </div>

        </div>


        <!-- User count -->

        <div class="user-count">

            <span class="user-count-number">
                @_users.Count
            </span>

            <span class="user-count-label">
                Users
            </span>

        </div>

    </div>


    <!-- ================================================== -->
    <!-- User List -->
    <!-- ================================================== -->
    @if (_users.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-state-title">
                Waiting for Users...
            </div>

            <div class="empty-state-subtitle">
                Connecting to the availability server
            </div>

        </div>
    }
    else
    {
        <div class="users-container">

            @foreach (var user in _users)
            {
                bool isAvailable =
                    user.IsAvailable ||
                    user.Status == Status.InOffice;


                <div class="user-card"
                     @onclick="() => OpenUserDetails(user)">

                    <div class="user-name">
                        @user.Name
                    </div>

                    <div class="user-status">

                        <span class="status-circle @(isAvailable
                                                                    ? "available"
                                                                    : "unavailable")">
                        </span>

                        <span class="status-text">
                            @GetStatusText(user)
                        </span>

                    </div>

                    <div class="office-timer">

                        <span class="office-timer-label">
                            Time in Office
                        </span>

                        <span class="office-timer-value">
                            @GetTimeInOffice(user)
                        </span>

                    </div>

                </div>
            }

        </div>

        @if (_selectedUser is not null)
        {
            <div class="user-details-overlay"
                 @onclick="CloseUserDetails">

                <div class="user-details-card"
                     @onclick:stopPropagation="true">

                    <!-- ========================================== -->
                    <!-- Header -->
                    <!-- ========================================== -->

                    <div class="details-header">

                        <div class="details-user-info">

                            <div class="details-user-name">
                                @_selectedUser.Name
                            </div>

                            <div class="details-user-status">

                                <span class="status-circle @(IsUserAvailable(_selectedUser)
                                                                                            ? "available"
                                                                                            : "unavailable")">
                                </span>

                                <span>
                                    @GetStatusText(_selectedUser)
                                </span>

                            </div>

                        </div>


                        <button class="details-close"
                                @onclick="CloseUserDetails">

                            ×

                        </button>

                    </div>


                    <!-- ========================================== -->
                    <!-- Current Timer -->
                    <!-- ========================================== -->

                    <div class="details-current-time">

                        <span class="details-current-label">
                            Today's Time in Office
                        </span>

                        <span class="details-current-value">
                            @GetTimeInOffice(_selectedUser)
                        </span>

                    </div>


                    <!-- ========================================== -->
                    <!-- Time Range -->
                    <!-- ========================================== -->

                    <div class="graph-controls">

                        <button class="range-button @(_selectedRange == GraphRange.Week ? "selected" : "")"
                                @onclick="() => SetRange(GraphRange.Week)">
                            Week
                        </button>

                        <button class="range-button @(_selectedRange == GraphRange.Month ? "selected" : "")"
                                @onclick="() => SetRange(GraphRange.Month)">
                            Month
                        </button>

                        <button class="range-button @(_selectedRange == GraphRange.Year ? "selected" : "")"
                                @onclick="() => SetRange(GraphRange.Year)">
                            Year
                        </button>

                        <button class="range-button @(_selectedRange == GraphRange.Custom ? "selected" : "")"
                                @onclick="() => SetRange(GraphRange.Custom)">
                            Custom
                        </button>


                        @if (_selectedRange == GraphRange.Custom)
                        {
                            <div class="custom-date-controls">

                                <div class="date-control">

                                    <label>
                                        Start
                                    </label>

                                    <input type="date"
                                           @bind="_customStartDate"
                                           @bind:after="CustomDateChanged" />

                                </div>


                                <div class="date-control">

                                    <label>
                                        End
                                    </label>

                                    <input type="date"
                                           @bind="_customEndDate"
                                           @bind:after="CustomDateChanged" />

                                </div>

                            </div>
                        }

                    </div>
                    

                    <!-- ========================================== -->
                    <!-- Summary Statistics -->
                    <!-- ========================================== -->

                    <div class="summary-statistics">

                        <div class="summary-stat-card">

                            <div class="summary-stat-label">
                                Total Time
                            </div>

                            <div class="summary-stat-value">
                                @FormatDuration(GetSummaryStatistics().TotalTime)
                            </div>

                            <div class="summary-stat-subtitle">
                                @GetSummaryPeriodText()
                            </div>

                        </div>


                        <div class="summary-stat-card">

                            <div class="summary-stat-label">
                                Average / Day
                            </div>

                            <div class="summary-stat-value">
                                @FormatDuration(GetSummaryStatistics().AverageTime)
                            </div>

                            <div class="summary-stat-subtitle">
                                Per calendar day
                            </div>

                        </div>


                        <div class="summary-stat-card">

                            <div class="summary-stat-label">
                                Days in Office
                            </div>

                            <div class="summary-stat-value">
                                @GetSummaryStatistics().DaysInOffice
                            </div>

                            <div class="summary-stat-subtitle">
                                Days with office time
                            </div>

                        </div>


                        <div class="summary-stat-card">

                            <div class="summary-stat-label">
                                Longest Day
                            </div>

                            <div class="summary-stat-value">
                                @FormatDuration(GetSummaryStatistics().LongestDay)
                            </div>

                            <div class="summary-stat-subtitle">
                                Best day in period
                            </div>

                        </div>

                    </div>
                    <!-- ========================================== -->
                    <!-- Graph -->
                    <!-- ========================================== -->

                    <div class="graph-section">

                        <div class="graph-title">
                            Time in Office
                        </div>

                        <div class="graph-subtitle">
                            @GetGraphDateDescription()
                        </div>


                        @if (_graphData.Count == 0)
                        {
                            <div class="graph-empty">
                                No office history available for this period.
                            </div>
                        }
                        else
                        {
                            <div class="graph-wrapper @(_graphAnimating ? "graph-changing" : "")">

                                @BuildGraph()

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>


<!-- ================================================== -->
<!-- CSS -->
<!-- ================================================== -->

<style>

    /* -------------------------------------------------- */
    /* Page */
    /* -------------------------------------------------- */

    .availability-page {
        min-height: 100vh;
        padding: 32px;
        box-sizing: border-box;
        background: #111111;
        color: #ffffff;
        font-family: "Segoe UI", Arial, sans-serif;
    }


    /* -------------------------------------------------- */
    /* Header */
    /* -------------------------------------------------- */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto 28px auto;
        padding-bottom: 20px;
        border-bottom: 1px solid #2d2d2d;
    }


        .page-header h1 {
            margin: 0 0 10px 0;
            font-size: 30px;
            font-weight: 500;
            letter-spacing: -0.4px;
            color: #ffffff;
        }


    /* -------------------------------------------------- */
    /* Connection Status */
    /* -------------------------------------------------- */

    .connection-status {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 12px;
        background: #1c1c1c;
        border: 1px solid #303030;
        border-radius: 7px;
        color: #a8a8a8;
        font-size: 13px;
    }


    .connection-indicator {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }


        .connection-indicator.connected {
            background: #f2c94c;
            box-shadow: 0 0 0 3px rgba(242, 201, 76, 0.12), 0 0 9px rgba(242, 201, 76, 0.25);
        }


        .connection-indicator.disconnected {
            background: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.10);
        }


    /* -------------------------------------------------- */
    /* User Count */
    /* -------------------------------------------------- */

    .user-count {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        color: #858585;
    }


    .user-count-number {
        font-size: 28px;
        line-height: 1;
        font-weight: 500;
        color: #f2c94c;
    }


    .user-count-label {
        margin-top: 5px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #777777;
    }


    /* -------------------------------------------------- */
    /* Users Container */
    /* -------------------------------------------------- */

    .users-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 12px;
    }


    /* -------------------------------------------------- */
    /* User Card */
    /* -------------------------------------------------- */

    .user-card {
        min-height: 125px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 18px;
        box-sizing: border-box;
        background: #1c1c1c;
        border: 1px solid #303030;
        border-radius: 10px;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }


        .user-card:hover {
            background: #222222;
            border-color: #454545;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.30);
            transform: translateY(-1px);
        }


    /* -------------------------------------------------- */
    /* User Name */
    /* -------------------------------------------------- */

    .user-name {
        margin-bottom: 10px;
        font-size: 20px;
        font-weight: 500;
        color: #ffffff;
        text-align: center;
    }


    /* -------------------------------------------------- */
    /* User Status */
    /* -------------------------------------------------- */

    .user-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        color: #a8a8a8;
        font-size: 14px;
        font-weight: 400;
    }

    /* ================================================== */
    /* Clickable User Card */
    /* ================================================== */

    .user-card {
        cursor: pointer;
    }


    /* ================================================== */
    /* Expanded User Overlay */
    /* ================================================== */

    .user-details-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        box-sizing: border-box;
        background: rgba(0, 0, 0, 0.78);
        animation: overlayFadeIn 0.22s ease-out;
    }


    @@keyframes overlayFadeIn {

        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }


    /* ================================================== */
    /* Expanded Card */
    /* ================================================== */

    .user-details-card {
        width: min(1200px, 100%);
        height: min(850px, 92vh);
        display: flex;
        flex-direction: column;
        padding: 32px;
        box-sizing: border-box;
        background: #181818;
        border: 1px solid #383838;
        border-radius: 16px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.55);
        overflow: hidden;
        animation: cardExpand 0.28s cubic-bezier(.2,.8,.2,1);
    }


    @@keyframes cardExpand {

        from {
            transform: scale(0.88);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }


    /* ================================================== */
    /* Details Header */
    /* ================================================== */

    /* ================================================== */
    /* Details Header */
    /* ================================================== */

    .details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 18px;
        border-bottom: 1px solid #303030;
    }


    /* User name + status */

    .details-user-info {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }


    .details-user-name {
        font-size: 30px;
        font-weight: 500;
        color: #ffffff;
        white-space: nowrap;
    }


    /* Status */

    .details-user-status {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px 11px;
        background: #222222;
        border: 1px solid #303030;
        border-radius: 7px;
        font-size: 13px;
        color: #999999;
        white-space: nowrap;
    }


    .details-close {
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 8px;
        background: #242424;
        color: #aaaaaa;
        font-size: 30px;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }


        .details-close:hover {
            background: #303030;
            color: #ffffff;
        }


    /* ================================================== */
    /* Current Time */
    /* ================================================== */

    .details-current-time {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 25px 0 20px;
    }


    .details-current-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666666;
    }


    .details-current-value {
        margin-top: 5px;
        font-size: 32px;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        color: #f2c94c;
    }


    /* ================================================== */
    /* Graph Controls */
    /* ================================================== */

    .graph-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 42px;
        box-sizing: border-box;
        margin-bottom: 15px;
        padding: 5px;
        background: #111111;
        border: 1px solid #292929;
        border-radius: 9px;
    }


    .range-button {
        height: 32px;
        min-height: 32px;
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: #888888;
        font-size: 13px;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }


        .range-button:hover {
            color: #ffffff;
            background: #242424;
        }


        .range-button.selected {
            background: #2a2a2a;
            color: #f2c94c;
        }


    /* ================================================== */
    /* Custom Dates */
    /* ================================================== */

    .custom-date-controls {
        display: flex;
        align-items: center;
        height: 32px;
        margin-left: 4px;
        padding-left: 10px;
        border-left: 1px solid #303030;
        gap: 10px;
        box-sizing: border-box;
        animation: customDatesAppear 0.22s ease-out;
    }


    .date-control {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #777777;
        font-size: 12px;
    }


        .date-control input {
            padding: 7px 9px;
            border: 1px solid #353535;
            border-radius: 6px;
            background: #222222;
            color: #ffffff;
        }


    /* ================================================== */
    /* Graph Section */
    /* ================================================== */

    .graph-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }


    .graph-title {
        font-size: 18px;
        font-weight: 500;
        color: #ffffff;
    }


    .graph-subtitle {
        margin-top: 3px;
        margin-bottom: 15px;
        font-size: 12px;
        color: #666666;
    }


    .graph-wrapper {
        flex: 1;
        min-height: 0;
        width: 100%;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        transform-origin: center bottom;
        animation: graphGrow 0.35s cubic-bezier(.2,.8,.2,1);
    }


    .graph-changing {
        animation: graphShrinkGrow 0.42s cubic-bezier(.2,.8,.2,1);
    }


    @@keyframes graphGrow {

        from {
            opacity: 0;
            transform: scaleY(0.85);
        }

        to {
            opacity: 1;
            transform: scaleY(1);
        }
    }


    @@keyframes graphShrinkGrow {

        0% {
            opacity: 1;
            transform: scaleY(1);
        }

        45% {
            opacity: 0.35;
            transform: scaleY(0.72);
        }

        100% {
            opacity: 1;
            transform: scaleY(1);
        }
    }


    .office-history-graph {
        width: 100%;
        height: 100%;
        min-height: 280px;
        display: block;
        overflow: visible;
    }


    .graph-empty {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666666;
        font-size: 14px;
    }

    /* ================================================== */
    /* Summary Statistics */
    /* ================================================== */

    .summary-statistics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 22px;
    }


    .summary-stat-card {
        min-height: 105px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 16px 18px;
        box-sizing: border-box;
        background: #111111;
        border: 1px solid #2d2d2d;
        border-radius: 9px;
        transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }


        .summary-stat-card:hover {
            background: #1c1c1c;
            border-color: #3a3a3a;
            transform: translateY(-1px);
        }


    .summary-stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666666;
        margin-bottom: 6px;
    }


    .summary-stat-value {
        font-size: 24px;
        font-weight: 500;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        color: #f2c94c;
    }


    .summary-stat-subtitle {
        margin-top: 6px;
        font-size: 11px;
        color: #555555;
    }

    /* ================================================== */
    /* Graph */
    /* ================================================== */

    .graph-grid-line {
        stroke: #2a2a2a;
        stroke-width: 1;
    }


    .graph-axis-label {
        fill: #666666;
        font-size: 15px;
    }


    .graph-date-label {
        fill: #777777;
        font-size: 15px;
    }


    .graph-line {
        fill: none;
        stroke: #f2c94c;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        filter: drop-shadow( 0 0 5px rgba(242, 201, 76, 0.25) );
    }


    .graph-point {
        fill: #181818;
        stroke: #f2c94c;
        stroke-width: 2;
    }


        .graph-point:hover {
            fill: #f2c94c;
        }


    /* ================================================== */
    /* Mobile */
    /* ================================================== */

    @@media (max-width: 700px) {

        .user-details-overlay {
            padding: 10px;
        }


        .user-details-card {
            width: 100%;
            height: 96vh;
            padding: 20px;
            border-radius: 12px;
        }


        .details-user-name {
            font-size: 24px;
        }


        .details-current-value {
            font-size: 27px;
        }


        .graph-controls {
            width: 100%;
        }


        .range-button {
            flex: 1;
            height: 32px;
            min-height: 32px;
            padding: 0 5px;
        }


        .custom-date-controls {
            flex-direction: column;
            align-items: center;
        }


        .summary-statistics {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }


        .summary-stat-card {
            min-height: 95px;
            padding: 14px;
        }


        .summary-stat-value {
            font-size: 20px;
        }
    }

    .status-text {
        white-space: nowrap;
    }

    @@media (max-width: 900px) {

        .summary-statistics {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    /* -------------------------------------------------- */
    /* Status Circle */
    /* -------------------------------------------------- */

    .status-circle {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }


        .status-circle.available {
            background-color: #2ecc71;
            box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.12), 0 0 10px rgba(46, 204, 113, 0.25);
        }


        .status-circle.unavailable {
            background: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.08);
        }


    /* -------------------------------------------------- */
    /* Office Timer */
    /* -------------------------------------------------- */

    .office-timer {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #2d2d2d;
        min-width: 130px;
    }


    .office-timer-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #666666;
        margin-bottom: 2px;
    }


    .office-timer-value {
        font-size: 16px;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        color: #f2c94c;
        letter-spacing: 0.5px;
    }


    /* -------------------------------------------------- */
    /* Empty State */
    /* -------------------------------------------------- */

    .empty-state {
        width: 100%;
        max-width: 1200px;
        min-height: 180px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        background: #1c1c1c;
        border: 1px solid #303030;
        border-radius: 10px;
    }


    .empty-state-title {
        margin-bottom: 7px;
        font-size: 18px;
        color: #ffffff;
    }


    .empty-state-subtitle {
        font-size: 14px;
        color: #777777;
    }


    /* -------------------------------------------------- */
    /* Tablet */
    /* -------------------------------------------------- */

    @@media (max-width: 700px) {

        .availability-page {
            padding: 20px;
        }


        .page-header {
            margin-bottom: 20px;
        }


            .page-header h1 {
                font-size: 25px;
            }


        .users-container {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }


        .user-card {
            min-height: 120px;
            padding: 14px;
        }


        .user-name {
            font-size: 18px;
        }
    }


    /* -------------------------------------------------- */
    /* Very Small Screens */
    /* -------------------------------------------------- */

    @@media (max-width: 450px) {

        .availability-page {
            padding: 12px;
        }


        .users-container {
            grid-template-columns: 1fr;
        }


        .user-count {
            display: none;
        }


        .page-header h1 {
            font-size: 23px;
        }
    }

</style>


@code
{
    private User? _selectedUser;

    private List<OfficeHistory> _userHistory = [];

    private GraphRange _selectedRange = GraphRange.Week;

    private DateOnly _customStartDate =
        DateOnly.FromDateTime(DateTime.Now.AddDays(-6));

    private List<GraphPoint> _graphData = [];

    private DateOnly _customEndDate =
        DateOnly.FromDateTime(DateTime.Now);

    private bool _graphAnimating;

    private List<User> _users = [];

    private PeriodicTimer? _timer;

    private CancellationTokenSource _timerCts = new();


    // ==================================================
    // Initialization
    // ==================================================

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine(
            "[Blazor Page] Initializing.");


        AvailabilityService.UserUpdated +=
            OnUserUpdated;


        AvailabilityService.UsersChanged +=
            OnUsersChanged;


        await AvailabilityService.ConnectAsync();


        _users =
            AvailabilityService.Users
                .Select(CloneUser)
                .ToList();


        Console.WriteLine(
            $"[Blazor Page] Initial users: " +
            $"{_users.Count}");


        _ = RunTimerAsync(
            _timerCts.Token);
    }


    // ==================================================
    // UI Refresh Timer
    // ==================================================

    private async Task RunTimerAsync(
        CancellationToken cancellationToken)
    {
        _timer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(1));


        try
        {
            while (await _timer.WaitForNextTickAsync(
                cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when component is disposed.
        }
        finally
        {
            _timer?.Dispose();

            _timer = null;
        }
    }


    // ==================================================
    // Time In Office
    // ==================================================

    private static string GetTimeInOffice(
        User user)
    {
        /*
         * TotalTimeInOffice is the accumulated
         * time from all COMPLETED office sessions.
         *
         * InOfficeStartTime is only populated while
         * the user is CURRENTLY in the office.
         */

        TimeSpan total =
            user.TotalTimeInOffice;


        /*
         * If the user is currently in the office,
         * add the current active session.
         */

        if (user.Status == Status.InOffice &&
            user.InOfficeStartTime is not null)
        {
            TimeSpan currentSession =
                DateTime.Now -
                user.InOfficeStartTime.Value;


            if (currentSession > TimeSpan.Zero)
            {
                total += currentSession;
            }
        }


        /*
         * If the user is NOT in the office,
         * this method adds nothing.
         *
         * Therefore:
         *
         *     TotalTimeInOffice
         *
         * is displayed unchanged.
         *
         * The UI continues refreshing every second,
         * but the displayed value remains frozen.
         */

        if (total < TimeSpan.Zero)
        {
            total = TimeSpan.Zero;
        }


        return
            $"{(int)total.TotalHours:00}:" +
            $"{total.Minutes:00}:" +
            $"{total.Seconds:00}";
    }


